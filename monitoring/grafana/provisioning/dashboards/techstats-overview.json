{
  "id": null,
  "uid": "techstats-overview",
  "title": "TechStats - Full Observability",
  "tags": ["techstats", "prometheus", "microservices"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "style": "dark",
  "time": { "from": "now-6h", "to": "now" },
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": { "type": "grafana", "uid": "-- Grafana --" },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "templating": { "list": [] },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Targets Up",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "none" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(up{job=~\"api-gateway|vacancy-service|analyzer-service|websocket-service|cache-service|node-exporter\"})"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Targets Down",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "none" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(1 - up{job=~\"api-gateway|vacancy-service|analyzer-service|websocket-service|cache-service|node-exporter\"})"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Overall Uptime %",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "percent", "decimals": 2 }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * avg(up{job=~\"api-gateway|vacancy-service|analyzer-service|websocket-service|cache-service|node-exporter\"})"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Availability By Job",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "percent" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * avg by(job) (up{job=~\"api-gateway|vacancy-service|analyzer-service|websocket-service|cache-service|node-exporter\"})",
          "legendFormat": "{{job}}"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "API Gateway RPS",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(http_requests_total{job=\"api-gateway\"}[5m]))",
          "legendFormat": "gateway"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Vacancy Service RPS",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(vacancy_requests_total{job=\"vacancy-service\"}[5m]))",
          "legendFormat": "vacancy"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "HTTP Error Rate %",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "percent" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * sum(rate(http_requests_total{job=\"api-gateway\",status=~\"4..|5..\"}[5m])) / clamp_min(sum(rate(http_requests_total{job=\"api-gateway\"}[5m])), 0.001)",
          "legendFormat": "gateway"
        },
        {
          "refId": "B",
          "expr": "100 * sum(rate(vacancy_requests_total{job=\"vacancy-service\",status=~\"4..|5..\"}[5m])) / clamp_min(sum(rate(vacancy_requests_total{job=\"vacancy-service\"}[5m])), 0.001)",
          "legendFormat": "vacancy"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Gateway p95 Latency",
      "gridPos": { "h": 8, "w": 6, "x": 0, "y": 12 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_request_duration_seconds_bucket{job=\"api-gateway\"}[5m])))"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Vacancy p95 Latency",
      "gridPos": { "h": 8, "w": 6, "x": 6, "y": 12 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(vacancy_request_duration_seconds_bucket{job=\"vacancy-service\"}[5m])))"
        }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Analyzer p95 Latency",
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 12 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(analysis_duration_seconds_bucket{job=\"analyzer-service\"}[5m])))"
        }
      ]
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "WebSocket Message p95",
      "gridPos": { "h": 8, "w": 6, "x": 18, "y": 12 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(websocket_message_processing_seconds_bucket{job=\"websocket-service\"}[5m])))"
        }
      ]
    },
    {
      "id": 12,
      "type": "stat",
      "title": "Cache Hit Ratio %",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 20 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "percent", "decimals": 2 }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * sum(rate(cache_hits_total{job=\"cache-service\"}[5m])) / clamp_min(sum(rate(cache_hits_total{job=\"cache-service\"}[5m])) + sum(rate(cache_misses_total{job=\"cache-service\"}[5m])), 0.001)"
        }
      ]
    },
    {
      "id": 13,
      "type": "stat",
      "title": "Active WS Connections",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 20 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "none" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(websocket_active_connections{job=\"websocket-service\"}) or vector(0)"
        }
      ]
    },
    {
      "id": 14,
      "type": "stat",
      "title": "Active Analyses",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 20 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "none" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(active_analyses{job=\"analyzer-service\"}) or vector(0)"
        }
      ]
    },
    {
      "id": 15,
      "type": "stat",
      "title": "CPU Usage %",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 20 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "percent", "decimals": 1 }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "100 - (avg(rate(node_cpu_seconds_total{job=\"node-exporter\",mode=\"idle\"}[5m])) * 100)"
        }
      ]
    },
    {
      "id": 16,
      "type": "timeseries",
      "title": "Cache Hits vs Misses",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 24 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(cache_hits_total{job=\"cache-service\"}[5m]))",
          "legendFormat": "hits/sec"
        },
        {
          "refId": "B",
          "expr": "sum(rate(cache_misses_total{job=\"cache-service\"}[5m]))",
          "legendFormat": "misses/sec"
        }
      ]
    },
    {
      "id": 17,
      "type": "timeseries",
      "title": "Cache Size/Memory By Node",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 24 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "none" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by(node) (cache_size_items{job=\"cache-service\"})",
          "legendFormat": "{{node}} items"
        },
        {
          "refId": "B",
          "expr": "sum by(node) (cache_memory_bytes{job=\"cache-service\"}) / 1024 / 1024",
          "legendFormat": "{{node}} MB"
        }
      ]
    },
    {
      "id": 18,
      "type": "timeseries",
      "title": "WebSocket Messages By Direction",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 24 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by(direction) (rate(websocket_messages_total{job=\"websocket-service\"}[5m]))",
          "legendFormat": "{{direction}}"
        }
      ]
    },
    {
      "id": 19,
      "type": "timeseries",
      "title": "Analysis Requests By Status",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 32 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by(status) (rate(analysis_requests_total{job=\"analyzer-service\"}[5m]))",
          "legendFormat": "{{status}}"
        }
      ]
    },
    {
      "id": 20,
      "type": "timeseries",
      "title": "Memory Usage % By Instance",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 32 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "percent" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "(1 - (node_memory_MemAvailable_bytes{job=\"node-exporter\"} / node_memory_MemTotal_bytes{job=\"node-exporter\"})) * 100",
          "legendFormat": "{{instance}}"
        }
      ]
    },
    {
      "id": 21,
      "type": "timeseries",
      "title": "Disk Usage % By Mount",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 32 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "percent" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * (1 - (node_filesystem_avail_bytes{job=\"node-exporter\",fstype!~\"tmpfs|overlay\"} / node_filesystem_size_bytes{job=\"node-exporter\",fstype!~\"tmpfs|overlay\"}))",
          "legendFormat": "{{instance}} {{mountpoint}}"
        }
      ]
    },
    {
      "id": 22,
      "type": "table",
      "title": "Top API Gateway Endpoints (RPS)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 40 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "topk(15, sum by (endpoint) (rate(http_requests_total{job=\"api-gateway\"}[5m])))",
          "format": "table",
          "instant": true
        }
      ],
      "options": { "showHeader": true }
    },
    {
      "id": 23,
      "type": "table",
      "title": "Top Vacancy Endpoints (RPS)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 40 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "topk(15, sum by (endpoint) (rate(vacancy_requests_total{job=\"vacancy-service\"}[5m])))",
          "format": "table",
          "instant": true
        }
      ],
      "options": { "showHeader": true }
    }
  ]
}

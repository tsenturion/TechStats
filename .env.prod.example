ENVIRONMENT=production
DEBUG=false

NGINX_HTTP_PORT=80
PROMETHEUS_RETENTION=200h

# Use deployment-specific origins, for example:
# CORS_ORIGINS=["https://techstats.example.com"]
CORS_ORIGINS=["http://localhost"]

ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
USER_USERNAME=
USER_PASSWORD=
JWT_SECRET_KEY=change-me-to-a-long-random-secret
CACHE_ADMIN_TOKEN=change-me-to-a-long-random-token
WEBSOCKET_ADMIN_TOKEN=change-me-to-a-long-random-token
GRAFANA_ADMIN_PASSWORD=change-me

HH_API_BASE_URL=https://api.hh.ru
HH_API_HOST=hh.ru
HH_API_USER_AGENT=TechStats/1.0 (api@techstats.local)
HH_API_CLIENT_ID=
HH_API_CLIENT_SECRET=
HH_API_ACCESS_TOKEN=
